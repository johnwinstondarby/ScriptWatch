/**
 * ScriptWatchJob.jsxinc
 * ---------------------
 * ScriptWatch Harness. This is the single preferred adoption point for suite
 * tools and an optional integration point for external/community scripts.
 *
 * Include order:
 *   #include "ScriptWatchHeartbeat.jsxinc"
 *   #include "ScriptWatchJob.jsxinc"
 *
 * The Harness is fail-isolated from the observed work. If the heartbeat
 * transport is absent or fails, the tool continues and Harness calls become
 * no-op observation.
 *
 * Two shapes:
 *   ScriptWatchJob.run({...})   collection-driven work
 *   ScriptWatchJob.begin({...}) phase-driven work
 */

// eslint-disable-next-line no-unused-vars
var ScriptWatchJob = (function () {

    var VERSION = "1.2";
    var MAX_RECORDED_ERRORS = 25;

    function available() {
        return (typeof ScriptWatch !== "undefined") && ScriptWatch && ScriptWatch.start;
    }

    function countOf(targets) {
        if (targets === null || targets === undefined) { return 0; }
        if (typeof targets === "number") { return targets; }
        try { return targets.length || 0; } catch (e) { return 0; }
    }

    function itemAt(targets, index) {
        if (targets === null || targets === undefined) { return index; }
        if (typeof targets === "number") { return index; }
        try { return targets[index]; } catch (e) { return index; }
    }

    function describe(error) {
        if (!error) { return "unknown error"; }
        var text = error.message || String(error);
        if (error.line) { text += " (line " + error.line + ")"; }
        return text;
    }

    function Session(opts) {
        opts = opts || {};
        this.tool = opts.tool || "tool";
        this.toolVersion = opts.toolVersion || "";
        this.mode = opts.mode || "phase";
        this.total = (typeof opts.total === "number") ? opts.total : 0;
        this.index = (typeof opts.startTarget === "number") ? opts.startTarget : 0;
        this.passCount = 0;
        this.failCount = 0;
        this.errors = [];
        this.checkpointEvery = (typeof opts.checkpointEvery === "number") ? opts.checkpointEvery : 25;
        this.gcOnCheckpoint = opts.gcOnCheckpoint !== false;
        this.contract = this.tool + " · harness " + VERSION;
        this.live = false;

        if (!available()) { return; }
        try {
            ScriptWatch.start({
                job: opts.job || this.tool || "ExtendScript Job",
                tool: this.tool,
                toolVersion: this.toolVersion,
                harnessVersion: VERSION,
                mode: this.mode,
                total: this.total,
                startTarget: this.index,
                path: opts.path,
                everyTargets: opts.everyTargets,
                everyMs: opts.everyMs
            });
            ScriptWatch.note(this.contract);
            this.live = true;
        } catch (e) {
            this.live = false;
        }
    }

    Session.prototype.step = function (label) {
        this.index += 1;
        if (this.live && label !== undefined) {
            try { ScriptWatch.note(this.contract + " · " + label); } catch (e) {}
        }
        return this.index;
    };

    Session.prototype.pass = function () {
        this.passCount += 1;
        this.report();
        return true;
    };

    Session.prototype.fail = function (reason) {
        this.failCount += 1;
        if (reason !== undefined && this.errors.length < MAX_RECORDED_ERRORS) {
            this.errors.push("target " + this.index + ": " + describe(reason));
        }
        this.report(true);
        return false;
    };

    Session.prototype.report = function (force) {
        if (!this.live) { return; }
        try {
            ScriptWatch.tick({
                target: this.index,
                total: this.total,
                pass: this.passCount,
                fail: this.failCount,
                force: force === true
            });
        } catch (e) {}
    };

    Session.prototype.note = function (text) {
        if (!this.live) { return; }
        try {
            ScriptWatch.note(this.contract +
                             (text !== undefined && text !== "" ? " · " + text : ""));
        } catch (e) {}
    };

    /**
     * Publish a numeric domain metric. opts may contain:
     *   unit, min, max, display (counter|dial|trend), note, force
     *
     * ScriptWatch stores the metric in the heartbeat and CSV. The dashboard
     * renders current custom metrics as number-in-box counters; display/min/max
     * metadata is retained so richer presentation can be added without changing
     * the producer contract.
     */
    Session.prototype.metric = function (name, value, opts) {
        if (!this.live || typeof ScriptWatch.metric !== "function") { return false; }
        try { return ScriptWatch.metric(name, value, opts || {}); } catch (e) {}
        return false;
    };

    Session.prototype.checkpoint = function () {
        if (!this.live) {
            if (this.gcOnCheckpoint) { try { $.gc(); $.gc(); } catch (e) {} }
            return this.index;
        }
        try { ScriptWatch.checkpoint(this.index, this.gcOnCheckpoint); } catch (e) {}
        return this.index;
    };

    Session.prototype.checkpointIfDue = function () {
        if (this.checkpointEvery > 0 && (this.index % this.checkpointEvery) === 0) {
            this.checkpoint();
        }
    };

    Session.prototype.end = function (status, note) {
        if (!this.live) { return this.summary(); }
        try {
            ScriptWatch.finish(status || "DONE",
                               this.contract +
                               (note !== undefined && note !== "" ? " · " + note : ""));
        } catch (e) {}
        this.live = false;
        return this.summary();
    };

    Session.prototype.summary = function () {
        return {
            tool: this.tool,
            toolVersion: this.toolVersion,
            harnessVersion: VERSION,
            mode: this.mode,
            total: this.total,
            completed: this.index,
            pass: this.passCount,
            fail: this.failCount,
            errors: this.errors
        };
    };

    var api = {};
    api.VERSION = VERSION;

    api.begin = function (opts) {
        opts = opts || {};
        var phaseOpts = {};
        var key;
        for (key in opts) {
            if (opts.hasOwnProperty ? opts.hasOwnProperty(key) : true) {
                phaseOpts[key] = opts[key];
            }
        }
        if (!phaseOpts.mode) { phaseOpts.mode = "phase"; }
        return new Session(phaseOpts);
    };

    /**
     * Collection-driven work. Returns
     * { tool, toolVersion, harnessVersion, mode, total, completed,
     *   pass, fail, errors, aborted }.
     */
    api.run = function (opts) {
        opts = opts || {};
        if (typeof opts.onTarget !== "function") {
            throw new Error("ScriptWatchJob.run requires an onTarget function");
        }

        var targets = opts.targets;
        var total = (typeof opts.total === "number") ? opts.total : countOf(targets);
        var start = (typeof opts.startTarget === "number") ? opts.startTarget : 0;
        var continueOnError = opts.continueOnError !== false;

        var session = new Session({
            job: opts.job,
            tool: opts.tool,
            toolVersion: opts.toolVersion,
            mode: opts.mode || "collection",
            total: total,
            startTarget: start,
            path: opts.path,
            everyTargets: opts.everyTargets,
            everyMs: opts.everyMs,
            checkpointEvery: opts.checkpointEvery,
            gcOnCheckpoint: opts.gcOnCheckpoint
        });

        var aborted = false;
        var fatal = null;

        try {
            for (var i = start; i < total; i += 1) {
                session.step();
                var outcome;
                try {
                    outcome = opts.onTarget(itemAt(targets, i), i + 1, session);
                    if (outcome === false) {
                        session.fail("reported failure");
                        if (!continueOnError) {
                            fatal = new Error("target " + session.index + " reported failure");
                            aborted = true;
                            break;
                        }
                    } else {
                        session.pass();
                    }
                } catch (targetError) {
                    session.fail(targetError);
                    if (!continueOnError) {
                        fatal = targetError;
                        aborted = true;
                        break;
                    }
                }

                session.checkpointIfDue();
                if (typeof opts.onCheckpoint === "function" &&
                    session.checkpointEvery > 0 &&
                    (session.index % session.checkpointEvery) === 0) {
                    try { opts.onCheckpoint(session.index, session); } catch (e) {}
                }
            }
        } catch (loopError) {
            fatal = loopError;
            aborted = true;
        } finally {
            session.end(aborted ? "ABORTED" : "DONE",
                        aborted ? describe(fatal) : undefined);
        }

        var result = session.summary();
        result.aborted = aborted;
        if (fatal && !continueOnError) { throw fatal; }
        return result;
    };

    return api;
})();
