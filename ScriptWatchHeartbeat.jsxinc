/**
 * ScriptWatchHeartbeat.jsxinc
 * ---------------------------
 * Fail-isolated heartbeat transport for ScriptWatch.
 *
 * The writer publishes job state through a small swap-written JSON file. Public
 * calls never throw into the observed job. Output uses the suite DocStats
 * directory with a temp-folder fallback. A lock file remains open for the life
 * of a job so an external monitor can match the heartbeat to the correct
 * InDesign process when psutil is available.
 *
 * ExtendScript is ES3: var only, no native JSON requirement.
 */

// eslint-disable-next-line no-unused-vars
var ScriptWatch = (function () {

    var SCHEMA_VERSION = "1.2";
    var MAX_METRICS = 32;

    var S = {
        job: "ExtendScript Job",
        tool: "",
        toolVersion: "",
        harnessVersion: "",
        mode: "",
        path: null,
        tmpPath: null,
        total: 0,
        target: 0,
        startTarget: 0,
        pass: 0,
        fail: 0,
        lastCheckpoint: 0,
        note: "",
        status: "STARTING",
        startMs: 0,
        lastWriteMs: 0,
        lastWriteTarget: -1,
        everyTargets: 5,
        everyMs: 10000,
        writes: 0,
        enabled: true,
        lockPath: null,
        lockFile: null,
        host: "",
        metrics: []
    };

    // ---------------------------------------------------------------- utils

    function slug(text) {
        return String(text).replace(/[^A-Za-z0-9._-]+/g, "-").replace(/^-+|-+$/g, "");
    }

    function pad(n, width) {
        var s = String(n);
        while (s.length < width) { s = "0" + s; }
        return s;
    }

    function stamp(date) {
        return date.getFullYear() + "-" + pad(date.getMonth() + 1, 2) + "-" +
               pad(date.getDate(), 2) + "T" + pad(date.getHours(), 2) + ":" +
               pad(date.getMinutes(), 2) + ":" + pad(date.getSeconds(), 2);
    }

    function esc(text) {
        var out = String(text);
        out = out.replace(/\\/g, "\\\\").replace(/"/g, '\\"');
        out = out.replace(/[\r\n\t]/g, " ");
        return out;
    }

    function numberOrNull(value) {
        return (typeof value === "number" && isFinite(value)) ? String(value) : "null";
    }

    function releaseLock() {
        if (!S.lockFile) { return; }
        try { S.lockFile.close(); } catch (eClose) {}
        try { S.lockFile.remove(); } catch (eRemove) {}
        S.lockFile = null;
    }

    var DOCSTATS_DIR = "D:/Recovery Community Dropbox/DARBY FAMILY/" +
                       "!!!New Business 2025/AI Ecosystem/DocStats";

    function defaultFolder() {
        var dir = new Folder(DOCSTATS_DIR);
        if (dir.exists) { return dir; }
        dir = new Folder(Folder.temp.fsName + "/ScriptWatch");
        if (!dir.exists) { dir.create(); }
        return dir;
    }

    function openLock(path) {
        try {
            var lock = new File(path);
            lock.encoding = "UTF-8";
            if (!lock.open("w")) { return null; }
            lock.write("ScriptWatch lock " + stamp(new Date()) + "\n");
            return lock;
        } catch (e) {
            return null;
        }
    }

    function resetForStart(opts) {
        releaseLock();
        S.enabled = opts.enabled !== false;
        S.job = opts.job || "ExtendScript Job";
        S.tool = opts.tool || "";
        S.toolVersion = opts.toolVersion || "";
        S.harnessVersion = opts.harnessVersion || "";
        S.mode = opts.mode || "";
        S.total = (typeof opts.total === "number") ? opts.total : 0;
        S.startTarget = (typeof opts.startTarget === "number") ? opts.startTarget : 0;
        S.target = S.startTarget;
        S.lastCheckpoint = S.startTarget;
        S.everyTargets = (typeof opts.everyTargets === "number") ? opts.everyTargets : 5;
        S.everyMs = (typeof opts.everyMs === "number") ? opts.everyMs : 10000;
        S.startMs = new Date().getTime();
        S.status = "RUNNING";
        S.pass = (typeof opts.pass === "number") ? opts.pass : 0;
        S.fail = (typeof opts.fail === "number") ? opts.fail : 0;
        S.note = "";
        S.writes = 0;
        S.lastWriteMs = 0;
        S.lastWriteTarget = -1;
        S.metrics = [];
        S.path = null;
        S.tmpPath = null;
        S.lockPath = null;
        S.host = "";
    }

    // --------------------------------------------------------------- metrics

    function metricIndex(name) {
        var i;
        for (i = 0; i < S.metrics.length; i += 1) {
            if (S.metrics[i].name === name) { return i; }
        }
        return -1;
    }

    function metricDisplay(value) {
        var display = String(value || "counter").toLowerCase();
        if (display !== "counter" && display !== "dial" && display !== "trend") {
            display = "counter";
        }
        return display;
    }

    function setMetric(name, value, opts) {
        if (!S.enabled || name === undefined || name === null || name === "") { return false; }
        if (typeof value !== "number" || !isFinite(value)) { return false; }
        opts = opts || {};
        name = String(name);
        var idx = metricIndex(name);
        if (idx < 0) {
            if (S.metrics.length >= MAX_METRICS) { return false; }
            idx = S.metrics.length;
            S.metrics.push({ name: name });
        }
        var metric = S.metrics[idx];
        metric.value = value;
        metric.unit = opts.unit !== undefined ? String(opts.unit) : (metric.unit || "");
        metric.display = metricDisplay(opts.display !== undefined ? opts.display : metric.display);
        metric.note = opts.note !== undefined ? String(opts.note) : (metric.note || "");
        metric.min = (typeof opts.min === "number" && isFinite(opts.min)) ? opts.min :
                     (typeof metric.min === "number" ? metric.min : null);
        metric.max = (typeof opts.max === "number" && isFinite(opts.max)) ? opts.max :
                     (typeof metric.max === "number" ? metric.max : null);
        return true;
    }

    function serializeMetric(metric) {
        var parts = [];
        parts.push('"name":"' + esc(metric.name) + '"');
        parts.push('"value":' + numberOrNull(metric.value));
        if (metric.unit) { parts.push('"unit":"' + esc(metric.unit) + '"'); }
        if (metric.display) { parts.push('"display":"' + esc(metric.display) + '"'); }
        if (metric.note) { parts.push('"note":"' + esc(metric.note) + '"'); }
        if (typeof metric.min === "number") { parts.push('"min":' + numberOrNull(metric.min)); }
        if (typeof metric.max === "number") { parts.push('"max":' + numberOrNull(metric.max)); }
        return "{" + parts.join(",") + "}";
    }

    function serializeMetrics() {
        var out = [];
        var i;
        for (i = 0; i < S.metrics.length; i += 1) {
            out.push(serializeMetric(S.metrics[i]));
        }
        return "[" + out.join(",") + "]";
    }

    // -------------------------------------------------------------- payload

    function serialize() {
        var elapsed = (new Date().getTime() - S.startMs) / 1000;
        var done = S.target - S.startTarget;
        var avg = done > 0 ? Math.round((elapsed * 1000) / done) : 0;
        var lines = [];
        lines.push('  "schemaVersion": "' + SCHEMA_VERSION + '"');
        lines.push('  "job": "' + esc(S.job) + '"');
        lines.push('  "status": "' + esc(S.status) + '"');
        lines.push('  "target": ' + S.target);
        lines.push('  "total": ' + S.total);
        lines.push('  "pass": ' + S.pass);
        lines.push('  "fail": ' + S.fail);
        lines.push('  "elapsedSeconds": ' + Math.round(elapsed));
        lines.push('  "averageTargetMs": ' + avg);
        lines.push('  "lastCheckpoint": ' + S.lastCheckpoint);
        lines.push('  "writes": ' + S.writes);
        lines.push('  "metrics": ' + serializeMetrics());
        lines.push('  "updated": "' + stamp(new Date()) + '"');
        if (S.tool) { lines.push('  "tool": "' + esc(S.tool) + '"'); }
        if (S.toolVersion) { lines.push('  "toolVersion": "' + esc(S.toolVersion) + '"'); }
        if (S.harnessVersion) { lines.push('  "harnessVersion": "' + esc(S.harnessVersion) + '"'); }
        if (S.mode) { lines.push('  "mode": "' + esc(S.mode) + '"'); }
        if (S.lockPath) { lines.push('  "lock": "' + esc(S.lockPath) + '"'); }
        if (S.host) { lines.push('  "host": "' + esc(S.host) + '"'); }
        if (S.note) { lines.push('  "note": "' + esc(S.note) + '"'); }
        return "{\n" + lines.join(",\n") + "\n}\n";
    }

    function flush() {
        if (!S.enabled || !S.path) { return false; }
        var tmp = new File(S.tmpPath);
        tmp.encoding = "UTF-8";
        tmp.lineFeed = "Unix";
        if (!tmp.open("w")) { return false; }
        tmp.write(serialize());
        tmp.close();

        var dst = new File(S.path);
        if (dst.exists) { dst.remove(); }
        tmp.rename(dst.name);

        S.writes += 1;
        S.lastWriteMs = new Date().getTime();
        S.lastWriteTarget = S.target;
        return true;
    }

    function due() {
        if (S.lastWriteTarget < 0) { return true; }
        if (S.everyTargets > 0 && (S.target - S.lastWriteTarget) >= S.everyTargets) { return true; }
        return S.everyMs > 0 && (new Date().getTime() - S.lastWriteMs) >= S.everyMs;
    }

    // --------------------------------------------------------------- public

    var api = {};
    api.SCHEMA_VERSION = SCHEMA_VERSION;

    /**
     * opts: job, tool, toolVersion, harnessVersion, mode, total, path,
     *       everyTargets, everyMs, startTarget, enabled, pass, fail
     */
    api.start = function (opts) {
        try {
            opts = opts || {};
            resetForStart(opts);
            if (!S.enabled) { return null; }

            var file = opts.path ? new File(opts.path)
                                 : new File(defaultFolder().fsName + "/" + slug(S.job) + ".json");
            S.path = file.fsName;
            S.tmpPath = file.fsName + ".tmp";
            S.lockPath = file.fsName.replace(/\.json$/i, "") + ".lock";
            S.lockFile = openLock(S.lockPath);
            try { S.host = $.getenv("COMPUTERNAME") || ""; } catch (eh) { S.host = ""; }
            flush();
            try { $.writeln("ScriptWatch heartbeat: " + S.path); } catch (ew) {}
        } catch (e) {
            S.enabled = false;
            releaseLock();
        }
        return S.path;
    };

    api.tick = function (opts) {
        try {
            if (!S.enabled) { return false; }
            opts = opts || {};
            if (typeof opts.target === "number") { S.target = opts.target; }
            if (typeof opts.ok === "boolean") {
                if (opts.ok) { S.pass += 1; } else { S.fail += 1; }
            }
            if (typeof opts.pass === "number") { S.pass = opts.pass; }
            if (typeof opts.fail === "number") { S.fail = opts.fail; }
            if (typeof opts.total === "number") { S.total = opts.total; }
            if (opts.note !== undefined) { S.note = opts.note; }
            if (opts.force || due()) { return flush(); }
        } catch (e) {}
        return false;
    };

    api.metric = function (name, value, opts) {
        try {
            opts = opts || {};
            var ok = setMetric(name, value, opts);
            if (ok && opts.force) { flush(); }
            return ok;
        } catch (e) {}
        return false;
    };

    api.checkpoint = function (target, gc) {
        try {
            if (typeof target === "number") {
                S.target = target;
                S.lastCheckpoint = target;
            } else {
                S.lastCheckpoint = S.target;
            }
            flush();
            if (gc) { $.gc(); $.gc(); }
        } catch (e) {}
        return S.lastCheckpoint;
    };

    api.note = function (text, force) {
        try {
            S.note = text || "";
            if (force) { flush(); }
        } catch (e) {}
    };

    api.finish = function (status, note) {
        try {
            S.status = status || "DONE";
            if (note !== undefined) { S.note = note; }
            flush();
        } catch (e) {}
        releaseLock();
        return S.path;
    };

    api.state = function () { return S; };

    return api;
})();
